// Inspired by Catnap
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "$HOME/.config/fastfetch/car.sixel",
        "type": "raw",
	"width": 32,
	"height": 16,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 1
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#39} user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {#39}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {#39}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {#39} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {#39} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#39}󰇄 desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#39} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#39} shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {#39}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#39}󰉉 disk    {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#39} memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {#39}󰩟 network {#keys}│",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
